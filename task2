
import java.util.*;

public class StockTradingPlatform {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] stocks = {"TCS", "INFY", "HDFC", "RELIANCE"};
        double[] prices = {3500, 1500, 1700, 2800};

        int[] quantity = new int[4];
        double balance = 100000;
        int choice;

        System.out.println("===== STOCK TRADING PLATFORM =====");
        System.out.println("Welcome to Stock Market Simulator!");
        System.out.println("Starting Balance: Rs. 100000");

        do {
            System.out.println("\n1. Display Market");
            System.out.println("2. Buy Stock");
            System.out.println("3. View Portfolio");
            System.out.println("4. Exit");
            System.out.print("Enter choice: ");

            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    System.out.println("\n--- STOCK MARKET ---");
                    for (int i = 0; i < stocks.length; i++) {
                        System.out.println(stocks[i] +
                                " : Rs. " + prices[i]);
                    }
                    break;

                case 2:
                    System.out.print("Enter stock number (1-4): ");
                    int num = sc.nextInt() - 1;

                    if (num < 0 || num >= stocks.length) {
                        System.out.println("Invalid stock number!");
                        break;
                    }

                    System.out.print("Enter quantity: ");
                    int qty = sc.nextInt();

                    if (qty <= 0) {
                        System.out.println("Invalid quantity!");
                    } else if (prices[num] * qty > balance) {
                        System.out.println("Insufficient balance!");
                    } else {
                        balance -= prices[num] * qty;
                        quantity[num] += qty;
                        System.out.println("Stock purchased successfully!");
                    }
                    break;

                case 3:
                    double holdings = 0;

                    System.out.println("\n--- YOUR PORTFOLIO ---");
                    for (int i = 0; i < stocks.length; i++) {
                        double value = quantity[i] * prices[i];
                        holdings += value;
                        if (quantity[i] > 0) {
                            System.out.println(stocks[i] +
                                    " | Quantity: " + quantity[i] +
                                    " | Value: Rs. " + value);
                        }
                    }

                    System.out.println("Cash Balance: Rs. " + balance);
                    System.out.println("Holdings Value: Rs. " + holdings);
                    System.out.println("Total Value: Rs. " +
                            (balance + holdings));
                    System.out.println("Profit/Loss: Rs. " +
                            (balance + holdings - 100000));
                    break;

                case 4:
                    System.out.println("Thank you for using Stock Trading Platform!");
                    break;

                default:
                    System.out.println("Invalid choice!");
            }
        } while (choice != 4);

        sc.close();
    }
}
